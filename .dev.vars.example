# Copy to .dev.vars for `wrangler dev`. Never commit real values.
# Cloud voice returns 503 VOICE_DISABLED until the OpenAI key is set.
OPENAI_API_KEY=
# Leave these empty locally: on localhost the Worker signs everyone in as dev@localhost.
ACCESS_TEAM_DOMAIN=
ACCESS_POLICY_AUD=
# Explicit local-only owner override. Do not use a client's headers/body to assign admin access.
# VOICE_ADMIN_USER_IDS=dev@localhost
# Default owner-only blocks every non-admin. limited-preview is for the existing Access allowlist,
# not public release: it counts starts but cannot cap direct WebRTC lifetime or dollar spend.
# Site-wide defaults in wrangler.jsonc include admin starts: 20/day and 100/month.
# VOICE_GLOBAL_DAILY_START_LIMIT and VOICE_GLOBAL_MONTHLY_START_LIMIT must be positive integers.
