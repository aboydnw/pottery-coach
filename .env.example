# Server-side only. Never prefix these variables with VITE_.
OPENAI_API_KEY=
# Shared bearer token for controlled field tests. Cloud voice returns 503 until this and OPENAI_API_KEY are set.
REALTIME_ACCESS_TOKEN=
# Optional comma-separated extra origins allowed to call /api/realtime/session.
REALTIME_ALLOWED_ORIGINS=
VOICE_MODEL=gpt-realtime-2.1-mini
