# Build settings for the potterycoach.anthonynboyd.com field-test deployment.
# Shows measurements before the physical measurement gate passes; the app labels them "unverified".
# The release manifest still records the gate as pending. Remove this line to go back to strict gating.
VITE_UNVERIFIED_MEASUREMENTS=true

# Offers the cloud voice coach (OpenAI Realtime) to whoever holds the passphrase set as the
# Worker secret REALTIME_ACCESS_TOKEN. The release manifest still records the provider gate as pending.
VITE_CLOUD_VOICE=true
