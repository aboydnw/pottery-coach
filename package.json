{
  "name": "pottery-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "benchmark:camera": "tsx benchmarks/camera/run.ts",
    "benchmark:tags": "tsx benchmarks/tags/run.ts",
    "benchmark:dimensions": "tsx benchmarks/dimensions/run.ts",
    "benchmark:segmentation": "tsx benchmarks/segmentation/run.ts",
    "benchmark:profile": "tsx benchmarks/profile/run.ts",
    "benchmark:wobble": "tsx benchmarks/wobble/run.ts",
    "benchmark:voice": "tsx benchmarks/voice/run.ts",
    "benchmark:coaching": "tsx benchmarks/coaching/run.ts",
    "benchmark:integrated": "tsx benchmarks/integrated/run.ts",
    "benchmark:verify-manifests": "node scripts/validate-field-manifests.mjs && node scripts/verify-plan-artifacts.mjs",
    "lint": "tsc --noEmit --pretty false",
    "e2e": "playwright test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "dexie": "~4.2.1",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router": "~8.4.0",
    "vite-plugin-pwa": "~1.1.0",
    "zod": "~4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.10.2",
    "@playwright/test": "~1.58.2",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "~5.0.4",
    "fake-indexeddb": "~6.2.5",
    "fast-check": "~4.3.0",
    "jsdom": "~27.0.1",
    "tsx": "~4.20.6",
    "typescript": "~7.0.2",
    "vite": "~7.1.3",
    "vitest": "~5.0.3"
  }
}
